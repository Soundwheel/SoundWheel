---
const { variant = "primary" } = Astro.props;
---

<button class={variant}>
  {(<slot />)}
</button>

<style>
  button {
    background-color: transparent;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }

  .primary {
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 10px 40px;
    cursor: pointer;
    display: block;
    margin: 0 auto;
    font-size: 1.2rem;
  }

  .secondary {
    background-color: transparent;
    color: #fffcf4;
    border: 2px solid #fffcf4;
    border-radius: 10px;
    padding: 10px 40px;
    cursor: pointer;
  }
  .tertiary {
    background-color: #384222;
    color: #fffcf4;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
    margin: 0 0 10px 0px;
  }

   .abonner {
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 8px 40px;
    cursor: pointer;
    display: block;
    margin: 0 auto;
    font-size: 0.8rem;
  }
</style>
