---
const { variant = "primary", icon = null } = Astro.props;
---

<button class={variant}>
  {icon === "facebook" && <i class="fa-brands fa-facebook-f" />}
  {icon === "instagram" && <i class="fa-brands fa-instagram" />}
  {!icon && <slot />}
</button>

<style>
  button {
    border: 2px solid #000;
    background-color: transparent;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }

  .secondary {
    background-color: transparent;
    color: #fffcf4;
    border: 2px solid #fffcf4;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }
  .tertiary {
    background-color: #384222;
    color: #fffcf4;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }
</style>
