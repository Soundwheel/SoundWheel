---
const { variant = "primary" } = Astro.props;
---

<button class={variant}>
  {(<slot />)}
</button>

<style>
  button {
    background-color: transparent;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }

  .primary {
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }

  .secondary {
    background-color: transparent;
    color: #fffcf4;
    border: 2px solid #fffcf4;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }
  .tertiary {
    background-color: #384222;
    color: #fffcf4;
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
  }
</style>
