---
import Button from "./Button.astro"
---
<footer>
     <hr>
     <div class="grid_1-1">
        <div class="footer1">
            <p>Download SoundWheel nu og prøv gratis i 14 dage</p>
            
            <div>
            <a href="https://apps.apple.com/dk/app/soundwheel-genoplad-via-musik/id1617422124?l=da">
             <Button variant="tertiary">App Store</Button>
             </a> 
      </div>
      <div>
            <a href="https://play.google.com/store/apps/details?id=com.soundwheel.soundwheel&pli=1">
             <Button variant="tertiary">Google Play</Button>
             </a>
             </div>
      
        </div>
        <div class="footer2">
            <p>Kontakt</p>
            <p>Persondatapolitik</p>
            <p>Handels og abonnementsbetingelser</p>
        </div>
     </div>
    </footer>

    <style>

        footer hr {
            margin: 20px 0 20px 0;
        }
        .grid_1-1 {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .footer1 p {
            max-width: 180px;
        }
        .footer2 p {
            text-align: right;
        }
    </style>