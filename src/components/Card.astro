---
const { variant, data } = Astro.props;
import Button from "./Button.astro";
---

<article class={variant}>
  <h3>Kun {data.pris} kr om året</h3>
  <p>Op til {data.medarbejdere} medarbejdere</p>
  <a href=`/singleview/${data.slug}`>
    <Button variant="secondary">Vælg plan</Button>
  </a>
</article>

<style>
  .pakker {
    background-color: #384222;
    border-radius: 20px;
    max-width: 300px;
    min-height: 230px;
    text-align: center;
    color: #fffcf4;
  }

  @media screen and (min-width: 800px) {
    .pakker {
      background-color: #384222;
      border-radius: 20px;
      color: #fffcf4;
      min-height: 250px;
    }
  }
</style>
