---
const { variant, img, text } = Astro.props;
---

<article class={variant}>
  <img src={img} />
  <p>{text}</p>
</article>

<style>
  article {
    background-color: #f6f5f3;
    border-radius: 10px;
  }

  img {
    max-width: 70%;
    display: block;
    margin: 0 auto;
    margin-top: 1rem;
  }

  text {
    text-align: center;
  }

  .green {
    background-color: #384222;
    color: #f6f5f3;
  }
</style>
