---
import PageLayout from "../layouts/PageLayout.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";

const url = "https://ieyfqctlzplaapoqopan.supabase.co/rest/v1/pakker";
const key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlleWZxY3RsenBsYWFwb3FvcGFuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM0NjQ2OTEsImV4cCI6MjA3OTA0MDY5MX0.CQhgTSMbim1yM03IMhSaB2fMyJAXw6dT-gg7qN6z7gs";

const options = {
  headers: {
    apikey: key,
  },
};

const supaRequset = await fetch(url, options);
const supaData = await supaRequset.json();

console.log("supaData", supaData);
---

<PageLayout>
  <body>
    <h1 class="center_overskrift">BEDRE PAUSER FOR DINE MEDARBEJDER</h1>
    <p class="center_overskrift">Stryk trivslen i din orginasion med SoundWheel Work.</p>
    <div class="grid_pris_1-1">
      <div>
        <img src="/public/stress.svg" alt="" />
        <p class="center_overskrift">En stress ramt sygemeldt kan om året koste en virksomhed op til 1.000.000 kr. om året.</p>
      </div>
      <div>
        <img src="/public/balance.svg" alt="" />
        <p class="center_overskrift">Soundwheel koster fra 9.999 kr. om året.</p>
      </div>
    </div>
    <hr />
    <div class="sektion_priser">
      <h2>Fuld adgang til SoundWheel Work</h2>
      <ul class="liste">
        <li>
          Musikdrevne visualiseringsøvelser
          <li>Dansk eller engelsk guide</li>
          <li>Mulighed for at slå guide til og fra</li>
          <li>6 temaer</li>
          <li>Mere musik, mindre tale</li>
          <li>Opret nemt dine medarbejdere</li>
          <li>Intropakke med promomateriale</li>
          <li>Tutorialvideoer med nem on-boarding</li>
        </li>
      </ul>
      <div class="headphones-image">
        <img class="headphones" src="/public/headphones.webp" alt="høretelefoner" />
      </div>
    </div>

    <div class="grid_1-1-1">
      {
        supaData.map((pakker, i) => {
          return <Card variant="pakker" data={pakker} />;
        })
      }
    </div>
    <h2 class="kontakt_os">
      Over 1.000 medarbejdere?<br /><b>Kontakt os</b>
    </h2>
  </body>

  <Footer />
</PageLayout>
