---
import PageLayout from "../layouts/PageLayout.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Cardsection from "../components/Cardsection.astro";
---

<PageLayout>
  <body>
    <section class="forside_page">
      <div class="forside_img">
        <div class="iconic"></div>
      </div>

      <h2>En guidet velfortjent pause for dine medarbejdere</h2>

      <div class="grid_1-1-1">
        <Cardsection img="/public/wheel.svg" text="ÅBEN SOUNDWHEEL" />
        <Cardsection img="/public/headphones.webp" text="TAG DINE HØRETELEFONER PÅ" />
        <Cardsection img="/public/immerse.webp" text="FORDYB DIG I OPLEVELSEN" />
      </div>

      <Button variant="primary">læs mere</Button>

      <hr class="normal_linje" />

      <div class="top_row">
        <div class="spin_hjul"></div>

        <div>
          <h3>Et godt arbejdsmiljø</h3>
          <p>Gør det nemt for medarbejderne at tage små pauser, som gør en stor forskel. Soundwheel har flere forskellige fordybende miljøer de kan træde ind i.</p>
        </div>
      </div>

      <div class="bottom_row">
        <div class="billede_stack">
          <div class="heste_img"></div>
          <div class="natur_img"></div>
        </div>

        <div class="texst_bottom_row">
          <h3>Forskellige verdener</h3>
          <p>Der er rig mulighed for universer at træde ind i. Der er blandt andet hesteflokke, i et med naturen og kreative rejser at være en del af.</p>
        </div>
      </div>
    </section>
  </body>

  <Footer />
</PageLayout>
